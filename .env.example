# ─── Environment variables — monorepo root ────────────────────────────────────
#
# Each service has its own .env.example with only the vars it needs:
#
#   apps/api/.env.example   →  copy to apps/api/.env          (local dev)
#   apps/web/.env.example   →  copy to apps/web/.env.local     (local dev)
#
# On Railway, set variables per service in each service's Variables tab.
# Do NOT use a shared Railway variable group across both services — the sets
# only partially overlap and mixing them causes unnecessary exposure.
#
# ─── Quick-start (local dev) ──────────────────────────────────────────────────
# cp apps/api/.env.example  apps/api/.env
# cp apps/web/.env.example  apps/web/.env.local
# # then fill in CLERK_SECRET_KEY, NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, DATABASE_URL
