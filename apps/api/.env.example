# ─── apps/api environment variables ──────────────────────────────────────────
# Set these in Railway: api service → Variables tab
#
# To run locally: cp apps/api/.env.example apps/api/.env

# ─── Clerk ────────────────────────────────────────────────────────────────────
# Secret key only — the API uses server-side Clerk SDK, no publishable key needed
CLERK_SECRET_KEY=sk_test_...

# ─── Database ─────────────────────────────────────────────────────────────────
# Railway injects ${{Postgres.DATABASE_URL}} automatically when you link the
# Postgres service. Paste that reference variable name as-is; Railway resolves it.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/small_software_cloud

# ─── Server ───────────────────────────────────────────────────────────────────
API_PORT=4000
NODE_ENV=production

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Set this to your Railway web service domain once deployed, e.g.:
# WEB_URL=https://web-production-xxxx.up.railway.app
WEB_URL=http://localhost:3000

# ─── Fly.io ───────────────────────────────────────────────────────────────────
# Get your token: flyctl auth token
FLY_API_TOKEN=fly_...
# The Fly org slug to create apps under (run `flyctl orgs list` to find yours)
FLY_ORG_SLUG=personal
