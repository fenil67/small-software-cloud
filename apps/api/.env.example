# ─── apps/api environment variables ──────────────────────────────────────────
# Set these in Railway: api service → Variables tab
#
# To run locally: cp apps/api/.env.example apps/api/.env

# ─── Clerk ────────────────────────────────────────────────────────────────────
# Secret key only — the API uses server-side Clerk SDK, no publishable key needed
CLERK_SECRET_KEY=sk_test_Ta0quGUWm8Y5RcUps9upNXpkKr4OhMtgSPEuDLVwB7

# ─── Database ─────────────────────────────────────────────────────────────────
# Railway injects ${{Postgres.DATABASE_URL}} automatically when you link the
# Postgres service. Paste that reference variable name as-is; Railway resolves it.
DATABASE_URL=postgresql://postgres:FvmLBzEDdkBwFCQXjwBKoOEeyGhYOKms@gondola.proxy.rlwy.net:38569:/railway

# ─── Server ───────────────────────────────────────────────────────────────────
API_PORT=4000
NODE_ENV=production

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Set this to your Railway web service domain once deployed, e.g.:
# WEB_URL=https://web-production-xxxx.up.railway.app
WEB_URL=http://localhost:3000

# ─── Fly.io ───────────────────────────────────────────────────────────────────
# Get your token: flyctl auth token
FLY_API_TOKEN=FlyV1 fm2_,fm2_lJPETi0SfcNpaYIBcCc3B8nFQT/K/A0JGH5mo8K4hmtEbJyTyXtDW05UID0rcf2CQC9bsJvW4bsFJPULGL81EdruFtzpA3XLkTe5hMhyv9FZtMQQyOg302eEYk6pVUq0QBeoCcO5aHR0cHM6Ly9hcGkuZmx5LmlvL2FhYS92MZgEks5qvfbRzwAAAAEmthTvF84AHHqVCpHOABx6lQzEEEDwfmsiTNSxwl5rmFh+iDXEID2nlg2uKnE2SZzGPTM2zjv6B1/hYRQfioQ9qJXZW5dr
