# ─── apps/web environment variables ──────────────────────────────────────────
# Set these in Railway: web service → Variables tab
#
# To run locally: cp apps/web/.env.example apps/web/.env.local

# ─── Clerk ────────────────────────────────────────────────────────────────────
# Both keys required — Next.js needs the publishable key at build time
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Y29tcG9zZWQtcmVpbmRlZXItNDcuY2xlcmsuYWNjb3VudHMuZGV2JA
CLERK_SECRET_KEY=sk_test_Ta0quGUWm8Y5RcUps9upNXpkKr4OhMtgSPEuDLVwB7

# Clerk redirect paths (relative URLs, not full domains)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── API ──────────────────────────────────────────────────────────────────────
# Set to your Railway api service domain once deployed, e.g.:
# NEXT_PUBLIC_API_URL=https://api-production-xxxx.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
